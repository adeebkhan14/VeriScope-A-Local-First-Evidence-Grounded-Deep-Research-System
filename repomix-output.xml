<file path="frontend/src/lib/citations.js">
/*
  Inline citation handling.

  The backend asks the model to cite evidence as "[Source 3]" (and models
  sometimes write "[3]" or "[Source 1, 2]"). These helpers turn those markers
  into links to "#source-N" so the UI can render a chip and open the matching
  evidence card. The numeric identifier is never changed, and markers that do
  not match a known evidence number are left exactly as the model wrote them.
*/

const MARKER = /\[(?:Source\s*)?(\d+(?:\s*,\s*(?:Source\s*)?\d+)*)\]/gi

function isWordCharacter(character) {
  return typeof character === 'string' && /[\p{L}\p{N}]/u.test(character)
}

/**
 * Splits one text value into text and citation-link mdast nodes.
 * Returns null when nothing in it should change.
 */
export function splitCitationText(value, knownIds) {
  const pattern = new RegExp(MARKER.source, 'gi')
  const nodes = []
  let lastIndex = 0
  let match

  while ((match = pattern.exec(value)) !== null) {
    const ids = match[1].match(/\d+/g).map(Number)
    const hasSourceWord = /source/i.test(match[0])
    // A bare "[1]" directly after a word is more likely an array index than a citation.
    const startsLikeCitation = hasSourceWord || !isWordCharacter(value[match.index - 1])
    if (!startsLikeCitation || !ids.every((id) => knownIds.has(id))) continue

    if (match.index > lastIndex) {
      nodes.push({ type: 'text', value: value.slice(lastIndex, match.index) })
    }
    for (const id of ids) {
      nodes.push({
        type: 'link',
        url: `#source-${id}`,
        title: null,
        children: [{ type: 'text', value: String(id) }],
        data: { hProperties: { 'data-citation': String(id) } },
      })
    }
    lastIndex = match.index + match[0].length
  }

  if (nodes.length === 0) return null
  if (lastIndex < value.length) nodes.push({ type: 'text', value: value.slice(lastIndex) })
  return nodes
}

const SKIPPED_NODE_TYPES = new Set(['link', 'linkReference', 'image', 'imageReference', 'code', 'inlineCode', 'html'])

/** remark plugin: options.ids is the list of known evidence numbers. */
export function remarkCitations(options = {}) {
  const knownIds = new Set(options.ids ?? [])

  function visit(node) {
    if (!Array.isArray(node.children) || SKIPPED_NODE_TYPES.has(node.type)) return
    node.children = node.children.flatMap((child) => {
      if (child.type === 'text') return splitCitationText(child.value, knownIds) ?? [child]
      visit(child)
      return [child]
    })
  }

  return (tree) => {
    if (knownIds.size > 0) visit(tree)
  }
}

/** Evidence numbers that the answer text actually cites. */
export function findCitedIds(text, knownIds) {
  const cited = new Set()
  if (typeof text !== 'string' || knownIds.size === 0) return cited
  const pattern = new RegExp(MARKER.source, 'gi')
  let match
  while ((match = pattern.exec(text)) !== null) {
    const ids = match[1].match(/\d+/g).map(Number)
    const hasSourceWord = /source/i.test(match[0])
    if (!hasSourceWord && isWordCharacter(text[match.index - 1])) continue
    if (ids.every((id) => knownIds.has(id))) ids.forEach((id) => cited.add(id))
  }
  return cited
}
</file>

<file path="frontend/src/lib/clipboard.js">
/** Copies text. Falls back to execCommand where the async Clipboard API is unavailable (e.g. plain HTTP on a LAN IP). */
export async function copyText(text) {
  try {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text)
      return true
    }
  } catch {
    // fall through to the legacy path
  }

  const field = document.createElement('textarea')
  field.value = text
  field.setAttribute('readonly', '')
  field.style.cssText = 'position:fixed;top:0;left:0;opacity:0;pointer-events:none'
  document.body.appendChild(field)
  field.select()
  try {
    return document.execCommand('copy')
  } catch {
    return false
  } finally {
    document.body.removeChild(field)
  }
}
</file>

<file path="frontend/src/lib/evidence.js">
import { getDomain, getSafeExternalUrl } from './format'

/**
 * Normalizes whatever evidence a message has into one list of card items.
 *
 * Sources, in order of preference:
 *  1. Live result `evidence`   - full extracted passages, with scores
 *  2. Live result `citations`  - passage snippets, with scores
 *  3. Persisted `evidenceReferences` (restored from SQLite) - passages, no scores
 *
 * Nothing is invented: a missing score stays null and is not rendered. The
 * backend uses score 0 as "no score" in its fallback paths, so 0 is hidden too.
 */
export function getEvidenceItems(research, evidenceReferences) {
  let raw = []

  if (research?.evidence?.length) {
    raw = research.evidence.map((item) => ({
      id: item.id,
      chunkId: item.chunkId,
      title: item.sourceTitle || item.title,
      url: item.url,
      text: item.text ?? item.snippet,
      score: item.score,
    }))
  } else if (research?.citations?.length) {
    raw = research.citations.map((item) => ({
      id: item.id,
      chunkId: null,
      title: item.title,
      url: item.url,
      text: item.snippet,
      score: item.score,
    }))
  } else if (evidenceReferences?.length) {
    raw = evidenceReferences.map((item) => ({
      id: item.sourceId,
      chunkId: item.chunkId,
      title: item.title,
      url: item.url,
      text: item.snippet,
      score: null,
    }))
  }

  return raw.map((item, index) => {
    const number = Number.isInteger(item.id) ? item.id : null
    const domain = getDomain(item.url)
    const title = typeof item.title === 'string' && item.title.trim() ? item.title.trim() : domain || 'Untitled source'
    const hasScore = typeof item.score === 'number' && Number.isFinite(item.score) && item.score > 0

    return {
      key: `${number ?? 'x'}-${item.chunkId ?? index}`,
      number,
      title,
      domain,
      url: getSafeExternalUrl(item.url),
      text: typeof item.text === 'string' ? item.text.trim() : '',
      score: hasScore ? item.score : null,
    }
  })
}

/** DOM id of one evidence card. Evidence numbers restart at 1 in every answer, so the message id scopes them. */
export function evidenceDomId(messageId, itemKey) {
  return `evidence-${messageId}-${itemKey}`
}

/** Keeps references from a live result in the shape the database stores. */
export function toEvidenceReferences(evidence) {
  return (Array.isArray(evidence) ? evidence : []).map((item) => ({
    sourceId: Number.isInteger(item?.id) ? item.id : null,
    chunkId: Number.isInteger(item?.chunkId) ? item.chunkId : null,
    title: typeof item?.title === 'string' ? item.title : null,
    url: typeof item?.url === 'string' ? item.url : null,
    snippet: typeof item?.text === 'string' ? item.text : null,
  }))
}

/** A short "kubernetes.io, cloud.google.com +2" summary of the distinct sites. */
export function summarizeDomains(items, visible = 3) {
  const domains = [...new Set(items.map((item) => item.domain).filter(Boolean))]
  if (domains.length === 0) return ''
  const shown = domains.slice(0, visible).join(', ')
  return domains.length > visible ? `${shown} +${domains.length - visible}` : shown
}
</file>

<file path="frontend/src/lib/format.js">
export function getDomain(url) {
  try {
    return new URL(url).hostname.replace(/^www\./, '')
  } catch {
    return ''
  }
}

/** Returns a normalized http(s) URL, or null for anything else (javascript:, data:, relative...). */
export function getSafeExternalUrl(url) {
  try {
    const parsed = new URL(url)
    return parsed.protocol === 'http:' || parsed.protocol === 'https:' ? parsed.href : null
  } catch {
    return null
  }
}

export function createId() {
  return globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2)}`
}

export function conversationTitle(conversation) {
  return conversation?.title?.trim() || 'Untitled conversation'
}

function conversationTime(conversation) {
  const value = conversation.updatedAt || conversation.updated_at || conversation.createdAt || conversation.created_at
  const time = new Date(value).getTime()
  return Number.isFinite(time) ? time : null
}

function startOfDay(date) {
  return new Date(date.getFullYear(), date.getMonth(), date.getDate()).getTime()
}

const DAY_MS = 24 * 60 * 60 * 1000

/**
 * Groups conversations by calendar day: Today, Yesterday, Previous 7 Days, Older.
 * Order inside each group follows the input order, so pass them newest first.
 */
export function groupConversations(conversations, now = new Date()) {
  const today = startOfDay(now)
  const groups = [
    { label: 'Today', items: [] },
    { label: 'Yesterday', items: [] },
    { label: 'Previous 7 Days', items: [] },
    { label: 'Older', items: [] },
  ]

  for (const conversation of conversations) {
    const time = conversationTime(conversation)
    const daysAgo = time === null ? Infinity : Math.round((today - startOfDay(new Date(time))) / DAY_MS)
    const index = daysAgo <= 0 ? 0 : daysAgo === 1 ? 1 : daysAgo <= 7 ? 2 : 3
    groups[index].items.push(conversation)
  }

  return groups.filter((group) => group.items.length > 0)
}

export function sortConversations(conversations) {
  return [...conversations].sort((first, second) => (conversationTime(second) ?? 0) - (conversationTime(first) ?? 0))
}

export function formatElapsed(totalSeconds) {
  const minutes = Math.floor(totalSeconds / 60)
  const seconds = String(totalSeconds % 60).padStart(2, '0')
  return `${minutes}:${seconds}`
}
