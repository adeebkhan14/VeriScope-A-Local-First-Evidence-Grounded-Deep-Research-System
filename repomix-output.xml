<file path="backend/src/server.js">
import express from "express";
import cors from "cors";
import { randomUUID } from "node:crypto";
import { resolve } from "node:path";
import { fileURLToPath } from "node:url";

import { createSearchRouter } from "./routes/search.js";
import { checkServiceHealth } from "./llm/ollamaHealth.js";
import { getMonitoringSnapshot } from "./monitoring.js";
import { createConversationStore } from "./conversationStore.js";

function createConversationRouter(store) {
  const router = express.Router();

  router.get("/", (req, res) => {
    res.json(store.listConversations());
  });

  router.post("/", (req, res) => {
    try {
      const title = typeof req.body?.title === "string" ? req.body.title.trim() : null;
      const text = typeof req.body?.message === "string" ? req.body.message.trim() : "";
      let conversation;
      if (text) {
        conversation = store.createConversationFromMessage(text);
        const message = store.saveMessage({
          conversationId: conversation.id,
          role: "user",
          content: text,
          status: "completed",
        });
        conversation = { ...conversation, message };
      } else {
        conversation = store.createConversation({ title: title || undefined });
      }
      res.status(201).json(conversation);
    } catch (error) {
      res.status(500).json({
        error: "Conversation creation failed",
        message: error.message,
      });
    }
  });

  router.get("/:conversationId", (req, res) => {
    try {
      const conversation = store.getConversation(req.params.conversationId);
      if (!conversation) {
        return res.status(404).json({
          error: "Conversation not found",
          message: `Conversation ${req.params.conversationId} does not exist.`,
        });
      }
      return res.json(conversation);
    } catch (error) {
      if (error?.code === "CONVERSATION_NOT_FOUND") {
        return res.status(404).json({
          error: "Conversation not found",
          message: error.message,
        });
      }
      return res.status(500).json({
        error: "Conversation lookup failed",
        message: error.message,
      });
    }
  });

  router.delete("/:conversationId", (req, res) => {
    try {
      const result = store.deleteConversation(req.params.conversationId);
      return res.json(result);
    } catch (error) {
      if (error?.code === "CONVERSATION_NOT_FOUND") {
        return res.status(404).json({
          error: "Conversation not found",
          message: error.message,
        });
      }
      return res.status(500).json({
        error: "Conversation deletion failed",
        message: error.message,
      });
    }
  });

  return router;
}

export function createApp({
  researchFn,
  healthCheckFn = checkServiceHealth,
  monitoringFn = getMonitoringSnapshot,
  conversationStore = createConversationStore(),
} = {}) {
  const app = express();

  const allowedOrigins = (process.env.CORS_ORIGINS || "")
    .split(",")
    .map((origin) => origin.trim())
    .filter(Boolean);
  app.disable("x-powered-by");
  app.use((req, res, next) => {
    const requestId =
      typeof req.get("x-request-id") === "string" && req.get("x-request-id").length <= 128
        ? req.get("x-request-id")
        : randomUUID();
    req.requestId = requestId;
    res.setHeader("X-Request-ID", requestId);
    res.setHeader("X-Content-Type-Options", "nosniff");
    res.setHeader("Referrer-Policy", "no-referrer");
    res.setHeader("X-Frame-Options", "DENY");
    next();
  });
  app.use(cors(
    allowedOrigins.length
      ? {
          origin(origin, callback) {
            if (!origin || allowedOrigins.includes(origin)) {
              callback(null, true);
            } else {
              callback(new Error("Origin is not allowed"));
            }
          },
        }
      : undefined
  ));
  app.use(express.json({ limit: "1mb" }));

  app.use("/api/conversations", createConversationRouter(conversationStore));
  const searchRouter = createSearchRouter(researchFn, { conversationStore });
  app.use("/api/conversations/:conversationId/messages", searchRouter);

  app.get("/", (req, res) => {
    res.json({
      name: "VeriScope API",
      status: "running",
    });
  });

  /**
   * Health check endpoint verifying local service connectivity without model generation.
   */
  app.get("/api/health", async (req, res) => {
    const services = await healthCheckFn();
    res.json({
      status: "online",
      backend: { status: "online" },
      services,
    });
  });

  app.get("/api/monitoring", async (req, res, next) => {
    try {
      return res.json(await monitoringFn());
    } catch (error) {
      return next(error);
    }
  });

  app.use("/api/search", searchRouter);

  app.use((error, req, res, next) => {
    if (res.headersSent) return next(error);

    if (error?.type === "entity.parse.failed") {
      return res.status(400).json({
        error: "Invalid request",
        message: "Request body must contain valid JSON",
      });
    }

    if (error?.type === "entity.too.large") {
      return res.status(413).json({
        error: "Invalid request",
        message: "Request body is too large",
      });
    }

    console.error("[API] Unhandled request error:", error);
    return res.status(500).json({
      error: "Internal server error",
      message: "The request could not be completed due to an unexpected server error.",
    });
  });

  return app;
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const PORT = process.env.PORT || 5001;
  createApp().listen(PORT, () => {
    console.log(`VeriScope backend running on port ${PORT}`);
  });
}
</file>

<file path="frontend/src/App.jsx">
import { useCallback, useEffect, useLayoutEffect, useRef, useState } from 'react'
import {
  deleteConversation as deleteConversationRequest,
  getConversation,
  listConversations,
  sendConversationMessage,
  startConversationResearch,
} from './conversationApi'
import { AssistantMessage, UserMessage } from './components/Message'
import Composer from './components/Composer'
import ConfirmDialog from './components/ConfirmDialog'
import Sidebar from './components/Sidebar'
import StatusLine from './components/StatusLine'
import { ArrowDownIcon, PanelLeftIcon } from './components/icons'
import { useHealth } from './hooks/useHealth'
import { useMediaQuery } from './hooks/useMediaQuery'
import { usePersistentState } from './hooks/usePersistentState'
import { useTheme } from './hooks/useTheme'
import { conversationTitle, createId, sortConversations } from './lib/format'
import {
  DEFAULT_ALPHA,
  DEFAULT_DEPTH,
  describeProgress,
  isValidAlpha,
  isValidDepth,
} from './lib/research'
import { readResearchStream } from './lib/stream'
import './App.css'

const ACTIVE_SESSION_KEY = 'veriscope-active-session'
const STICK_THRESHOLD = 120

function readStoredSession() {
  try {
    return globalThis.localStorage.getItem(ACTIVE_SESSION_KEY) || null
  } catch {
    return null
  }
}

function writeStoredSession(id) {
  try {
    if (id) globalThis.localStorage.setItem(ACTIVE_SESSION_KEY, id)
    else globalThis.localStorage.removeItem(ACTIVE_SESSION_KEY)
  } catch {
    // storage unavailable: restoring the last conversation is a convenience only
  }
}

/** A message restored from the database can never still be streaming: the request that owned it is gone. */
function normalizeRestoredMessage(message) {
  if (message.status !== 'streaming') return message
  return { ...message, status: 'failed', content: message.content || '', error: 'This research was interrupted before it finished.' }
}

function errorText(error, fallback) {
  return error instanceof Error && error.message ? error.message : fallback
}

export default function App() {
  const [theme, setTheme] = useTheme()
  const health = useHealth()
  const isDesktop = useMediaQuery('(min-width: 768px)')

  // Composer preferences. New keys: the old ones stored bare strings in a different format.
  const [depth, setDepth] = usePersistentState('veriscope-depth-v2', DEFAULT_DEPTH, isValidDepth)
  const [alpha, setAlpha] = usePersistentState('veriscope-alpha-v2', DEFAULT_ALPHA, isValidAlpha)
  const [forceWeb, setForceWeb] = useState(false)
  const [query, setQuery] = useState('')

  const [sidebarOpen, setSidebarOpen] = useState(() => globalThis.matchMedia?.('(min-width: 768px)').matches ?? true)
  const [sidebarSearch, setSidebarSearch] = useState('')
  const [conversations, setConversations] = useState([])
  const [listLoading, setListLoading] = useState(true)
  const [listError, setListError] = useState('')
  const [activeId, setActiveId] = useState(null)
  const [messages, setMessages] = useState([])
  const [conversationLoading, setConversationLoading] = useState(false)
  const [conversationError, setConversationError] = useState('')
  const [busy, setBusy] = useState(false)
  const [progress, setProgress] = useState('')
  const [deleteTarget, setDeleteTarget] = useState(null)
  const [deleting, setDeleting] = useState(false)
  const [showJump, setShowJump] = useState(false)

  const requestInFlight = useRef(false)
  const searchController = useRef(null)
  const loadController = useRef(null)
  const activeIdRef = useRef(null)
  const generation = useRef(0)
  const persistedIds = useRef(new Set())
  const scrollRef = useRef(null)
  const stickRef = useRef(true)
  const textareaRef = useRef(null)

  // ---------- Sidebar follows the breakpoint: open on desktop, closed overlay on mobile ----------
  useEffect(() => {
    setSidebarOpen(isDesktop)
  }, [isDesktop])

  useEffect(() => {
    if (isDesktop || !sidebarOpen) return undefined
    const onKeyDown = (event) => event.key === 'Escape' && setSidebarOpen(false)
    document.addEventListener('keydown', onKeyDown)
    return () => document.removeEventListener('keydown', onKeyDown)
  }, [isDesktop, sidebarOpen])

  // Only ever writes a value. Clearing is explicit (new conversation, delete, 404), because on the
  // first render activeId is still null and clearing here would erase the session we are about to restore.
  useEffect(() => {
    if (activeId) writeStoredSession(activeId)
  }, [activeId])

  // ---------- Scrolling: follow new content only while the reader is at the bottom ----------
  useLayoutEffect(() => {
    const element = scrollRef.current
    if (element && stickRef.current) element.scrollTop = element.scrollHeight
  }, [messages, conversationLoading])

  const handleScroll = useCallback(() => {
    const element = scrollRef.current
    if (!element) return
    const nearBottom = element.scrollHeight - element.scrollTop - element.clientHeight < STICK_THRESHOLD
    stickRef.current = nearBottom
    setShowJump(!nearBottom)
  }, [])

  const jumpToLatest = useCallback(() => {
    const element = scrollRef.current
    if (!element) return
    stickRef.current = true
    setShowJump(false)
    element.scrollTo({ top: element.scrollHeight, behavior: 'smooth' })
  }, [])

  // ---------- Conversation list ----------
  const refreshConversations = useCallback(async ({ silent = false, signal } = {}) => {
    try {
      const entries = await listConversations({ signal })
      if (!Array.isArray(entries)) throw new Error('The conversation service returned an invalid list.')
      entries.forEach((entry) => persistedIds.current.add(entry.id))
      setConversations(sortConversations(entries))
      setListError('')
      return entries
    } catch (error) {
      if (error?.name === 'AbortError') return null
      if (!silent) setListError(errorText(error, 'Conversation history could not be loaded.'))
      return null
    }
  }, [])

  const selectConversation = useCallback(async (conversationId) => {
    if (!conversationId) return
    const run = ++generation.current

    searchController.current?.abort()
    searchController.current = null
    requestInFlight.current = false
    loadController.current?.abort()
    const controller = new AbortController()
    loadController.current = controller

    activeIdRef.current = conversationId
    setActiveId(conversationId)
    setMessages([])
    setBusy(false)
    setProgress('')
    setConversationError('')
    setConversationLoading(true)
    stickRef.current = true

    try {
      const conversation = await getConversation(conversationId, { signal: controller.signal })
      if (run !== generation.current) return
      if (conversation.id !== conversationId || !Array.isArray(conversation.messages)) {
        throw new Error('The conversation service returned an invalid conversation.')
      }
      setMessages(conversation.messages.map(normalizeRestoredMessage))
    } catch (error) {
      if (run !== generation.current || error?.name === 'AbortError') return
      setConversationError(errorText(error, 'This conversation could not be loaded.'))
      if (error?.status === 404) {
        persistedIds.current.delete(conversationId)
        setConversations((entries) => entries.filter((entry) => entry.id !== conversationId))
        activeIdRef.current = null
        setActiveId(null)
        writeStoredSession(null)
      }
    } finally {
      if (run === generation.current) {
        setConversationLoading(false)
        if (loadController.current === controller) loadController.current = null
      }
    }
  }, [])

  // Initial load, restoring the conversation that was open last time.
  useEffect(() => {
    const controller = new AbortController()

    async function load() {
      setListLoading(true)
      const entries = await refreshConversations({ signal: controller.signal })
      if (controller.signal.aborted) return
      setListLoading(false)

      const savedId = readStoredSession()
      if (savedId && entries?.some((entry) => entry.id === savedId)) selectConversation(savedId)
      else if (savedId && entries) writeStoredSession(null)
    }

    load()
    return () => {
      controller.abort()
      loadController.current?.abort()
      searchController.current?.abort()
    }
  }, [refreshConversations, selectConversation])

  const startNewConversation = useCallback(() => {
    generation.current += 1
    searchController.current?.abort()
    searchController.current = null
    loadController.current?.abort()
    loadController.current = null
    requestInFlight.current = false
    activeIdRef.current = null
    writeStoredSession(null)

    setActiveId(null)
    setMessages([])
    setQuery('')
    setBusy(false)
    setProgress('')
    setConversationLoading(false)
    setConversationError('')
    setForceWeb(false)
    stickRef.current = true
    if (!isDesktop) setSidebarOpen(false)
    window.setTimeout(() => textareaRef.current?.focus(), 0)
  }, [isDesktop])

  const handleSelect = useCallback(
    (id) => {
      if (!isDesktop) setSidebarOpen(false)
      if (id !== activeIdRef.current) selectConversation(id)
    },
    [isDesktop, selectConversation]
  )

  async function confirmDelete() {
    const target = deleteTarget
    if (!target || deleting) return

    setDeleting(true)
    const isActive = activeIdRef.current === target.id
    try {
      await deleteConversationRequest(target.id)
      persistedIds.current.delete(target.id)
      setConversations((entries) => entries.filter((entry) => entry.id !== target.id))
      if (isActive) startNewConversation()
      setDeleteTarget(null)
    } catch (error) {
      setDeleteTarget(null)
      setListError(errorText(error, 'Conversation could not be deleted.'))
    } finally {
      setDeleting(false)
    }
  }

  // ---------- Research ----------
  async function handleSubmit() {
    const text = query.trim()
    if (!text || requestInFlight.current) return

    const run = generation.current
    const sessionId = activeIdRef.current || createId()
    const assistantKey = `a-${createId()}`
    const userKey = `u-${createId()}`
    const controller = new AbortController()

    requestInFlight.current = true
    searchController.current = controller
    activeIdRef.current = sessionId
    stickRef.current = true

    setActiveId(sessionId)
    setBusy(true)
    setProgress('Starting…')
    setConversationError('')
    setQuery('')
    setMessages((current) => [
      ...current,
      { id: userKey, clientKey: userKey, conversationId: sessionId, role: 'user', content: text, status: 'completed' },
      { id: assistantKey, clientKey: assistantKey, conversationId: sessionId, role: 'assistant', content: '', status: 'streaming' },
    ])

    const patchAssistant = (patch) =>
      setMessages((current) =>
        current.map((message) =>
          message.clientKey === assistantKey ? (typeof patch === 'function' ? patch(message) : { ...message, ...patch }) : message
        )
      )

    // Tokens arrive far faster than the screen refreshes; batch them to one render per frame.
    let pendingText = ''
    let frame = 0
    const flushTokens = () => {
      if (frame) cancelAnimationFrame(frame)
      frame = 0
      if (!pendingText) return
      const chunk = pendingText
      pendingText = ''
      patchAssistant((message) => ({ ...message, content: message.content + chunk }))
    }
    const discardTokens = () => {
      if (frame) cancelAnimationFrame(frame)
      frame = 0
      pendingText = ''
    }

    const isCurrent = () => run === generation.current && activeIdRef.current === sessionId

    try {
      const payload = { query: text, forceWebSearch: Boolean(forceWeb), depth, alpha }
      const response = persistedIds.current.has(sessionId)
        ? await sendConversationMessage(sessionId, payload, controller.signal)
        : await startConversationResearch({ ...payload, sessionId }, controller.signal)

      if (!isCurrent()) return

      const data = await readResearchStream(response, {
        onStatus(status) {
          if (!isCurrent()) return
          // The backend restarts the answer after the local attempt and switches to web research.
          if (/^Querying SearXNG/i.test(status)) {
            discardTokens()
            patchAssistant({ content: '' })
          }
          setProgress(describeProgress(status))
        },
        onToken(token) {
          if (!isCurrent()) return
          pendingText += token
          if (!frame) frame = requestAnimationFrame(flushTokens)
        },
      })

      if (!isCurrent()) return
      discardTokens()

      if (typeof data.answer !== 'string' || !Array.isArray(data.citations)) {
        throw new Error(data.message || 'The research service returned an unexpected response.')
      }

      persistedIds.current.add(sessionId)
      setMessages((current) =>
        current.map((message) => {
          if (message.clientKey === userKey) return { ...message, id: data.userMessageId || message.id }
          if (message.clientKey === assistantKey) {
            return {
              ...message,
              id: data.assistantMessageId || message.id,
              content: data.answer,
              status: 'completed',
              research: data,
            }
          }
          return message
        })
      )
      refreshConversations({ silent: true })
    } catch (error) {
      if (isCurrent()) {
        flushTokens()
        const aborted = error?.name === 'AbortError'
        patchAssistant({
          status: 'failed',
          error: aborted ? 'Research was stopped.' : errorText(error, 'Research could not be completed.'),
        })
        refreshConversations({ silent: true })
      }
    } finally {
      discardTokens()
      if (searchController.current === controller) searchController.current = null
      if (run === generation.current) {
        requestInFlight.current = false
        setBusy(false)
        setProgress('')
      }
    }
  }

  const handleStop = useCallback(() => searchController.current?.abort(), [])

  const landing = !activeId
  const lastStreamingKey = busy ? messages.findLast?.((message) => message.status === 'streaming')?.clientKey ?? null : null

  return (
    <div className="app">
      <Sidebar
        open={sidebarOpen}
        conversations={conversations}
        activeId={activeId}
        loading={listLoading}
        error={listError}
        search={sidebarSearch}
        onSearchChange={setSidebarSearch}
        onSelect={handleSelect}
        onDelete={setDeleteTarget}
        onNew={startNewConversation}
        onClose={() => setSidebarOpen(false)}
        onRetry={() => {
          setListLoading(true)
          refreshConversations().finally(() => setListLoading(false))
        }}
        theme={theme}
        onThemeChange={setTheme}
      />

      {!isDesktop && sidebarOpen && (
        <button type="button" className="scrim" aria-label="Close sidebar" onClick={() => setSidebarOpen(false)} />
      )}

      <main className="workspace" data-landing={landing}>
        <header className="topbar">
          {!sidebarOpen && (
            <button type="button" className="icon-btn" onClick={() => setSidebarOpen(true)} aria-label="Open sidebar">
              <PanelLeftIcon size={18} />
            </button>
          )}
        </header>

        <div className="stage">
          <div className="scroll" ref={scrollRef} onScroll={handleScroll}>
            <div className="column thread">
              {conversationLoading && <p className="thread-note">Loading conversation…</p>}
              {messages.map((message) =>
                message.role === 'user' ? (
                  <UserMessage key={message.clientKey ?? message.id} message={message} />
                ) : (
                  <AssistantMessage
                    key={message.clientKey ?? message.id}
                    message={message}
                    progress={message.clientKey && message.clientKey === lastStreamingKey ? progress : undefined}
                  />
                )
              )}
            </div>
          </div>

          {showJump && !landing && (
            <button type="button" className="jump" onClick={jumpToLatest} aria-label="Jump to latest">
              <ArrowDownIcon size={16} />
            </button>
          )}
        </div>

        <div className="dock">
          <div className="column">
            {landing && (
              <div className="landing">
                <h1>VeriScope</h1>
                <p>Follow the evidence.</p>
              </div>
            )}

            {conversationError && (
              <div className="banner" role="alert">
                <span>{conversationError}</span>
                {activeId && !conversationLoading && messages.length === 0 && (
                  <button type="button" className="link-btn" onClick={() => selectConversation(activeId)}>
                    Retry
                  </button>
                )}
              </div>
            )}

            <Composer
              value={query}
              onChange={setQuery}
              onSubmit={handleSubmit}
              onStop={handleStop}
              busy={busy}
              depth={depth}
              onDepthChange={setDepth}
              alpha={alpha}
              onAlphaChange={setAlpha}
              forceWeb={forceWeb}
              onForceWebChange={setForceWeb}
              textareaRef={textareaRef}
            />
            <StatusLine health={health} />
          </div>
        </div>
      </main>

      <ConfirmDialog
        open={Boolean(deleteTarget)}
        title="Delete conversation?"
        description={`"${deleteTarget ? conversationTitle(deleteTarget) : ''}" and all of its messages will be permanently deleted.`}
        confirmLabel={deleting ? 'Deleting…' : 'Delete'}
        onConfirm={confirmDelete}
        onCancel={() => !deleting && setDeleteTarget(null)}
      />
    </div>
  )
}
</file>

<file path="README.md">
# VeriScope --- Local-First Evidence-Grounded Deep Research System

VeriScope is a local-first research system that searches the web,
extracts webpage content, retrieves relevant evidence using lexical +
semantic search, and generates a grounded answer using a locally running
Qwen 3.5 9B model.

The current architecture is:

``` text
React UI
   ↓
Express Backend
   ↓
Research Pipeline
   ├── SearXNG → web discovery
   ├── Axios + Cheerio → webpage extraction
   ├── Playwright → JS-heavy webpage fallback
   ├── Chunking
   ├── BM25 → lexical retrieval
   ├── MiniLM → semantic embeddings
   ├── Hybrid retrieval
   ├── Evidence selection
   └── Ollama + Qwen 3.5 9B → grounded answer
```

Completed research results are stored in the browser's local IndexedDB
database. The research library supports full-text search over saved
questions and answers, saved-result filtering, reopening, copying answer
text, deleting individual entries, and clearing the local library. This
browser storage is not sent to the backend or synchronized across devices.

------------------------------------------------------------------------

# 1. Prerequisites

The same Docker Compose project runs on macOS and Windows with Docker
Desktop. Ollama and Qwen 3.5 9B remain native host prerequisites; SearXNG,
the frontend, backend, and MiniLM run in Compose.

You need:

- Docker Engine (Docker Desktop on macOS/Windows)
- Ollama installed on the host
- The `qwen3.5:9b` model downloaded in Ollama
- Node.js, npm, and Python 3 only for native/manual development

## Ubuntu/Linux startup

On Ubuntu, Docker Engine can run the SearXNG and MiniLM containers while
the frontend and backend run natively. This keeps Ollama on its default
loopback-only listener, which containers cannot reach through
`host.docker.internal` on Linux.

Make sure Docker Engine is running and your account can access it. If you
were just added to the `docker` group, sign out and back in, or run
`newgrp docker` in the terminal you use below. Install Node.js 22 or
newer and Ollama, then download the model with `ollama run qwen3.5:9b`.

From the project root, create a private SearXNG secret and start the
containerized services:

```sh
cp .env.example .env
sed -i "s/^SEARXNG_SECRET=.*/SEARXNG_SECRET=$(openssl rand -hex 32)/" .env
docker compose up -d --build searxng embedding
```

In one terminal, install and start the backend:

```sh
cd backend
npm ci
node --env-file=../.env src/server.js
```

In another terminal, install and start the frontend:

```sh
cd frontend
npm ci
npm run dev
```

Open **http://localhost:5173**. Keep Ollama running on the host. The
embedding image downloads the MiniLM model on its first start and may
take a few minutes. To stop the containerized services, run
`docker compose down` from the project root.

For a Docker-only launch, verify Docker Desktop is running:

```text
docker --version
docker compose version
docker info
```

# 2. Project structure

The repository contains the React frontend, Express backend, FastAPI
embedding service, Compose definition, and project-managed SearXNG
settings. SearXNG's cache and Valkey state are stored in named Docker
volumes.

# 3. Install Docker Desktop

Install Docker Desktop for macOS or Windows from the official Docker
website. On Windows, use the WSL 2 backend if Docker Desktop offers the
choice.

After installation, open Docker Desktop and wait until Docker is
running.

------------------------------------------------------------------------

# 4. Configure SearXNG and local environment

SearXNG is used by VeriScope for web search/discovery.

It is NOT the final retrieval system. It gives VeriScope URLs that can
then be scraped and processed locally.

Copy the sample environment file once.

macOS:

```sh
cp .env.example .env
openssl rand -hex 32
```

Windows PowerShell:

```powershell
Copy-Item .env.example .env
$rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
$bytes = New-Object byte[] 32
$rng.GetBytes($bytes)
($bytes | ForEach-Object { $_.ToString('x2') }) -join ''
```

Put the generated value in `.env` as `SEARXNG_SECRET`. Keep `.env`
private; it is ignored by Git. The checked-in
[`searxng/settings.yml`](./searxng/settings.yml) preserves the existing
default SearXNG settings and JSON search format. The secret is supplied at
runtime, not stored in the settings file or image.

The previous separate SearXNG project is not modified or removed by this
migration. VeriScope now has its own managed SearXNG configuration and
persistent cache/Valkey volumes. If the old service is still using port
8080, either stop it yourself when convenient or change `SEARXNG_PORT` in
`.env` (for example, to `8081`). For native backend development, also set
`SEARXNG_URL=http://localhost:8081` in `.env`. Compose backend traffic
continues to use the internal `searxng:8080` address. The old project
remains available independently.

------------------------------------------------------------------------

# 5. Install Ollama

Ollama runs the local language model used by VeriScope.

Install Ollama for macOS or Windows from the official Ollama download
page. Keep Ollama running on the host; it is deliberately not
containerized.

After installation, check:

``` bash
ollama --version
```

Check installed models:

``` bash
ollama list
```

------------------------------------------------------------------------

# 6. Install Qwen 3.5 9B

VeriScope uses the `qwen3.5:9b` model by default. You can override the
model with the `OLLAMA_MODEL` environment variable.

Download/run it:

``` bash
ollama run qwen3.5:9b
```

The first run downloads the model. Verify it is installed:

``` bash
ollama list
```

------------------------------------------------------------------------

# 7. Ollama connectivity

Native backend development uses `http://localhost:11434`. A containerized
backend uses `http://host.docker.internal:11434`. Compose maps that name to
the host gateway.

On Linux, a host Ollama service bound only to `127.0.0.1` is reachable by a
native backend but not by a container through the Docker gateway. Keep the
native URL as `http://localhost:11434`. For Compose, use
`http://host.docker.internal:11434`. The Linux Compose override provides a
small bridge-only proxy that listens on the Docker host-gateway address and
forwards to `127.0.0.1:11434`; the Ollama service stays loopback-only. The
proxy refuses to bind unless the address belongs to a Docker bridge interface.
It does not change firewall rules or expose Ollama to a LAN/public interface.

------------------------------------------------------------------------

# 8. Native/manual development prerequisites

The Compose startup does not require local Node.js or Python. For the
native workflow, install project dependencies once:

```sh
cd backend
npm ci
cd ../frontend
npm ci
```

------------------------------------------------------------------------

# 9. Setup the Local MiniLM Embedding Service

For manual development, start MiniLM in its own terminal. From the
repository root on macOS:

```sh
python3 -m venv backend/embedding-service/venv
source backend/embedding-service/venv/bin/activate
pip install -r backend/embedding-service/requirements.txt
cd backend/embedding-service
uvicorn app:app --host 127.0.0.1 --port 8000
```

On Windows PowerShell:

```powershell
py -3 -m venv backend\embedding-service\venv
.\backend\embedding-service\venv\Scripts\Activate.ps1
python -m pip install -r backend\embedding-service\requirements.txt
Set-Location backend\embedding-service
python -m uvicorn app:app --host 127.0.0.1 --port 8000
```

------------------------------------------------------------------------

# 10. Start the VeriScope Backend

Start Ollama and MiniLM, then start the Compose-managed SearXNG service
from the repository root with `docker compose up -d searxng`. Keep `.env`
in the repository root, then start the backend from `backend/` so Node loads the native
service URLs from that file:

```sh
cd backend
node --env-file=../.env src/server.js
```

Without `.env`, native defaults use SearXNG at `http://localhost:8080`,
Ollama at `http://localhost:11434`, and MiniLM at
`http://127.0.0.1:8000`.

------------------------------------------------------------------------

# 11. Test the Backend Research API

You can test the complete research pipeline without React.

From another terminal on macOS:

```sh
curl -X POST http://localhost:5001/api/search \
  -H "Content-Type: application/json" \
  -d '{"query":"How does Kubernetes perform service discovery?"}'
```

On Windows PowerShell:

```powershell
