/* App shell: sidebar + workspace. Component styles live next to their components. */
.app {
  display: flex;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
}

.workspace {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.topbar {
  flex: none;
  display: flex;
  align-items: center;
  height: 48px;
  padding: 0 12px;
}

.topbar:empty {
  height: 12px;
}

.column {
  width: 100%;
  max-width: calc(var(--content-w) + 48px);
  margin: 0 auto;
  padding: 0 24px;
}

/* ---------- Thread ---------- */
.stage {
  position: relative;
  flex: 1;
  min-height: 0;
}

.scroll {
  height: 100%;
  overflow-y: auto;
  overscroll-behavior: contain;
}

.thread {
  display: flex;
  flex-direction: column;
  gap: 28px;
  padding-top: 12px;
  padding-bottom: 28px;
}

.thread-note {
  font-size: 14px;
  color: var(--text-2);
}

.jump {
  position: absolute;
  bottom: 10px;
  left: 50%;
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  padding: 0;
  color: var(--text);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 50%;
  box-shadow: var(--shadow-pop);
  transform: translateX(-50%);
  transition: background-color 0.15s var(--ease);
}

.jump:hover {
  background: var(--hover);
}

/* ---------- Dock: composer + status, always at the bottom of the conversation ---------- */
.dock {
  flex: none;
  padding-bottom: max(12px, env(safe-area-inset-bottom));
}

.banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
  padding: 9px 14px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--danger);
  border: 1px solid color-mix(in srgb, var(--danger) 35%, var(--border));
  border-radius: var(--radius-md);
  overflow-wrap: anywhere;
}

.banner .link-btn {
  flex: none;
  color: var(--danger);
}

/* ---------- Landing: same composer, centred in the workspace ---------- */
.workspace[data-landing='true'] .stage {
  flex: 0 0 0;
}

.workspace[data-landing='true'] .dock {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-bottom: 8vh;
}

.landing {
  margin-bottom: 28px;
  text-align: center;
}

.landing h1 {
  font-size: 34px;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.02em;
}

.landing p {
  margin-top: 8px;
  font-size: 16px;
  font-style: italic;
  color: var(--text-2);
}

/* ---------- Mobile overlay scrim ---------- */
.scrim {
  position: fixed;
  inset: 0;
  z-index: 40;
  padding: 0;
  background: var(--scrim);
  border: 0;
  animation: scrim-in 0.2s var(--ease);
}

@keyframes scrim-in {
  from {
    opacity: 0;
  }
}

@media (max-width: 767px) {
  .column {
    padding: 0 16px;
  }

  .thread {
    gap: 24px;
  }

  .landing h1 {
    font-size: 30px;
  }

  .workspace[data-landing='true'] .dock {
    padding-bottom: 4vh;
  }
}
