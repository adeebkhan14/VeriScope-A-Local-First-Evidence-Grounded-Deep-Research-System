.composer {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 12px 10px 16px;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
}

.composer:focus-within {
  border-color: var(--border-strong);
  box-shadow: 0 0 0 3px var(--ring);
}

.composer-input {
  display: block;
  width: 100%;
  min-height: 28px;
  max-height: 200px;
  padding: 2px 4px 2px 0;
  font-size: 16px; /* 16px stops iOS Safari zooming the page on focus */
  line-height: 1.55;
  color: var(--text);
  background: transparent;
  border: 0;
  outline: 0;
  resize: none;
}

.composer-input::placeholder {
  color: var(--text-2);
}

.composer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.composer-controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  min-width: 0;
}

/* ---------- Mode selector ---------- */
.segmented {
  display: inline-flex;
  margin: 0;
  padding: 2px;
  background: var(--hover);
  border: 0;
  border-radius: 9px;
}

.segmented-item {
  position: relative;
}

.segmented-item input {
  position: absolute;
  inset: 0;
  margin: 0;
  opacity: 0;
  cursor: pointer;
}

.segmented-item span {
  display: block;
  padding: 4px 11px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-2);
  border-radius: 7px;
  transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
}

.segmented-item:hover span {
  color: var(--text);
}

.segmented-item input:checked + span {
  color: var(--text);
  background: var(--bg);
  box-shadow: 0 0 0 1px var(--border);
}

.segmented-item input:focus-visible + span {
  outline: 2px solid var(--text);
  outline-offset: 1px;
}

/* ---------- Chips (alpha, web) ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 30px;
  padding: 0 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--text-2);
  background: transparent;
  border: 1px solid transparent;
  border-radius: 9px;
  transition: background-color 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease);
}

.chip:hover,
.chip[aria-expanded='true'] {
  color: var(--text);
  background: var(--hover);
}

.tabular {
  font-variant-numeric: tabular-nums;
}

/* Forced web search must be unmistakable when on */
.web-toggle[data-on='true'] {
  color: var(--inverse-text);
  background: var(--inverse-bg);
}

.web-toggle[data-on='true']:hover {
  color: var(--inverse-text);
  background: var(--inverse-bg);
  opacity: 0.88;
}

/* ---------- Alpha popover ---------- */
.alpha {
  position: relative;
}

.alpha-popover {
  bottom: calc(100% + 8px);
  left: 0;
  width: 290px;
  padding: 14px 16px 12px;
}

.alpha-head {
