.slider::-moz-range-track {
  height: 4px;
  background: var(--border-strong);
  border-radius: 999px;
}

.slider::-webkit-slider-thumb {
  width: 16px;
  height: 16px;
  margin-top: -6px;
  background: var(--text);
  border: 2px solid var(--bg);
  border-radius: 50%;
  box-shadow: 0 0 0 1px var(--border-strong);
