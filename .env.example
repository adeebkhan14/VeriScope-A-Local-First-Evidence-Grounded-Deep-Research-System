# Native backend development (run from backend/ with Node's --env-file=../.env)
SEARXNG_URL=http://localhost:8080
OLLAMA_URL=http://localhost:11434
EMBEDDING_URL=http://127.0.0.1:8000/embed

# URLs used by the containerized backend. Keep Compose service names for
# container-to-container traffic; host.docker.internal reaches native Ollama.
DOCKER_SEARXNG_URL=http://searxng:8080
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
DOCKER_EMBEDDING_URL=http://embedding:8000/embed
EVIDENCE_JUDGE_TIMEOUT_MS=180000

# Required by SearXNG. Replace this placeholder with a unique random secret.
SEARXNG_SECRET=replace-with-a-unique-random-secret

# Host-only SearXNG access. Change the port if another local SearXNG uses 8080.
SEARXNG_HOST_BIND=127.0.0.1
SEARXNG_PORT=8080
